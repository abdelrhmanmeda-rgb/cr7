# Local development: only set a unique password if you want a local test admin.
# INVESTMENT_PREVIEW_ADMIN_PASSWORD=
#
# Existing Vercel app / Preview scope only, with a separate Firebase project:
# INVESTMENT_MODE=sandbox
# INVESTMENT_SANDBOX_ORIGIN=https://your-isolated-preview-domain.example
# INVESTMENT_SANDBOX_PROJECT=
# INVESTMENT_LEGACY_FIREBASE_PROJECT=
# INVESTMENT_FIREBASE_CREDENTIALS=
# INVESTMENT_FIREBASE_WEB_KEY=
